# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.

# ─── Application ─────────────────────────────────────────────────────────────
SECRETARY_PASSWORD=ChangeMe@2026!
ConnectionStrings__DefaultConnection=Data Source=/app/data/DentalClinic.db
AllowedHosts=*

# ─── SMTP (optional — email features) ────────────────────────────────────────
SmtpSettings__Host=smtp.example.com
SmtpSettings__Port=587
SmtpSettings__Username=no-reply@example.com
SmtpSettings__Password=smtp-password
SmtpSettings__FromAddress=no-reply@example.com

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=ChangeGrafana@2026!

# ─── Alerting (Slack webhook URL — set in Alertmanager config or here) ────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
