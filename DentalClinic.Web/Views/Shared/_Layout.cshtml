<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DentaCare Clinic — Online Appointment & Management System" />
    <title>@ViewData["Title"] — DentaCare Clinic</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ═══════ NAVBAR ═══════════════════════════════════════════════════════════ -->
<nav class="navbar navbar-expand-lg navbar-dark dc-navbar">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <i class="bi bi-tooth-fill fs-4"></i>
            <span class="fw-700">DentaCare</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                @if (User.IsInRole("Secretary"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Secretary" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Secretary" asp-action="Calendar">
                            <i class="bi bi-calendar3 me-1"></i>Calendar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Secretary" asp-action="Payments">
                            <i class="bi bi-cash-coin me-1"></i>Payments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Secretary" asp-action="Customers">
                            <i class="bi bi-people me-1"></i>Patients
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Secretary" asp-action="Doctors">
                            <i class="bi bi-person-badge me-1"></i>Doctors
                        </a>
                    </li>
                }

                @if (User.IsInRole("Doctor"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Doctor" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2 me-1"></i>My Dashboard
                        </a>
                    </li>
                }

                @if (User.IsInRole("Customer"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                            <i class="bi bi-calendar-check me-1"></i>My Appointments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointment" asp-action="Book">
                            <i class="bi bi-plus-circle me-1"></i>Book Appointment
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointment" asp-action="History">
                            <i class="bi bi-clock-history me-1"></i>History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="PaymentHistory">
                            <i class="bi bi-receipt me-1"></i>Payments
                        </a>
                    </li>
                }
            </ul>

            <!-- Right side: Auth / Notification badge -->
            <ul class="navbar-nav align-items-center gap-2">
                @if (User.Identity!.IsAuthenticated)
                {
                    @if (User.IsInRole("Customer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Notification" asp-action="All"
                               id="notification-bell">
                                <i class="bi bi-bell-fill fs-5"></i>
                                <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle
                                      badge rounded-pill bg-danger d-none">0</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                           id="userDropdown" role="button" data-bs-toggle="dropdown">
                            <span class="dc-avatar">@User.Identity.Name?.Substring(0, 1).ToUpper()</span>
                            <span class="d-none d-lg-inline">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">Signed in as</h6></li>
                            <li><span class="dropdown-item-text text-muted small">@User.Identity.Name</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (User.IsInRole("Customer"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Customer" asp-action="EditProfile">
                                        <i class="bi bi-person-gear me-2"></i>Edit Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-dc-primary btn-sm ms-2" asp-controller="Account" asp-action="Register">
                            Register
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- ═══════ FLASH MESSAGES ═══════════════════════════════════════════════════ -->
<div class="container-fluid px-4 mt-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

<!-- ═══════ MAIN CONTENT ════════════════════════════════════════════════════ -->
<main class="dc-main">
    @RenderBody()
</main>

<!-- ═══════ FOOTER ══════════════════════════════════════════════════════════ -->
<footer class="dc-footer">
    <div class="container text-center">
        <small class="text-muted">
            &copy; @DateTime.Now.Year <strong>DentaCare Clinic</strong> — Dental Appointment &amp; Management System
        </small>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Notification badge polling (Customer only) -->
@if (User.IsInRole("Customer"))
{
    <script>
        async function refreshNotifBadge() {
            try {
                const res = await fetch('/Notification/Unread');
                const data = await res.json();
                const badge = document.getElementById('notif-badge');
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            } catch { /* silent */ }
        }
        refreshNotifBadge();
        setInterval(refreshNotifBadge, 60000); // poll every 60 seconds
    </script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
