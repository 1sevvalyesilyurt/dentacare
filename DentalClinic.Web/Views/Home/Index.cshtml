@{
    ViewData["Title"] = "Welcome — DentaCare Clinic";
    Layout = null; // Full-screen portal — no shared navbar
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DentaCare Clinic — Select your portal to continue" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy:    #0f1b2d;
            --card-bg: #162235;
            --border:  #243448;
            --teal:    #0fa4af;
            --amber:   #f0c040;
            --purple:  #7c6fe0;
            --green:   #22c55e;
            --muted:   #8fa3be;
        }

        html, body {
            min-height: 100vh;
            background: var(--navy);
            font-family: 'Inter', sans-serif;
            color: #e8edf4;
        }

        /* ─── Background orbs ─────────────────────────────────── */
        .orbs {
            position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 0;
        }
        .orb {
            position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.18;
        }
        .orb1 { width: 500px; height: 500px; background: var(--teal);   top: -150px; left: -100px; }
        .orb2 { width: 400px; height: 400px; background: var(--purple); bottom: -100px; right: -100px; }
        .orb3 { width: 300px; height: 300px; background: var(--amber);  top: 40%; left: 60%; }

        /* ─── Layout ──────────────────────────────────────────── */
        .portal-wrap {
            position: relative; z-index: 1;
            min-height: 100vh;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 2rem 1rem;
        }

        /* ─── Header ──────────────────────────────────────────── */
        .portal-logo {
            display: flex; align-items: center; gap: 0.75rem;
            font-size: 1.6rem; font-weight: 800; margin-bottom: 0.5rem;
            color: var(--teal);
        }
        .portal-logo i { font-size: 2rem; }
        .portal-subtitle { color: var(--muted); font-size: 0.95rem; margin-bottom: 3rem; text-align: center; }

        /* ─── Cards grid ──────────────────────────────────────── */
        .portal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.5rem;
            width: 100%;
            max-width: 880px;
        }

        .portal-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 2.5rem 2rem;
            text-align: center;
            text-decoration: none;
            color: inherit;
            transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
            position: relative; overflow: hidden;
        }

        .portal-card::before {
            content: '';
            position: absolute; inset: 0;
            opacity: 0;
            transition: opacity 0.25s;
            border-radius: 20px;
        }

        .portal-card:hover {
            transform: translateY(-8px);
            color: inherit;
            text-decoration: none;
        }

        .portal-card:hover::before { opacity: 1; }

        /* Secretary — deep red/maroon */
        .card-secretary { border-color: rgba(239,68,68,0.3); }
        .card-secretary::before { background: radial-gradient(circle at 50% 0%, rgba(239,68,68,0.12), transparent 70%); }
        .card-secretary:hover { box-shadow: 0 20px 60px rgba(239,68,68,0.25); border-color: rgba(239,68,68,0.6); }
        .card-secretary .icon-wrap { background: rgba(239,68,68,0.15); color: #ef4444; }

        /* Doctor — teal clinical */
        .card-doctor { border-color: rgba(15,164,175,0.3); }
        .card-doctor::before { background: radial-gradient(circle at 50% 0%, rgba(15,164,175,0.15), transparent 70%); }
        .card-doctor:hover { box-shadow: 0 20px 60px rgba(15,164,175,0.25); border-color: rgba(15,164,175,0.6); }
        .card-doctor .icon-wrap { background: rgba(15,164,175,0.15); color: var(--teal); }

        /* Patient — warm amber/green */
        .card-patient { border-color: rgba(34,197,94,0.3); }
        .card-patient::before { background: radial-gradient(circle at 50% 0%, rgba(34,197,94,0.12), transparent 70%); }
        .card-patient:hover { box-shadow: 0 20px 60px rgba(34,197,94,0.25); border-color: rgba(34,197,94,0.6); }
        .card-patient .icon-wrap { background: rgba(34,197,94,0.15); color: var(--green); }

        .icon-wrap {
            width: 72px; height: 72px;
            border-radius: 20px;
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem;
            margin: 0 auto 1.5rem;
        }

        .portal-card h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 0.5rem; }
        .portal-card p  { font-size: 0.85rem; color: var(--muted); margin-bottom: 1.5rem; line-height: 1.6; }

        .portal-btn {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.6rem 1.5rem;
            border-radius: 10px;
            font-size: 0.88rem; font-weight: 600;
            border: 1.5px solid currentColor;
            transition: background 0.2s, color 0.2s;
        }

        .card-secretary .portal-btn { color: #ef4444; }
        .card-secretary .portal-btn:hover { background: #ef4444; color: #fff; }
        .card-doctor   .portal-btn { color: var(--teal); }
        .card-doctor   .portal-btn:hover { background: var(--teal); color: #fff; }
        .card-patient  .portal-btn { color: var(--green); }
        .card-patient  .portal-btn:hover { background: var(--green); color: #fff; }

        .portal-card .badge-role {
            display: inline-block;
            font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 3px 10px; border-radius: 20px;
            margin-bottom: 1rem;
        }
        .card-secretary .badge-role { background: rgba(239,68,68,0.15); color: #ef4444; }
        .card-doctor   .badge-role { background: rgba(15,164,175,0.15); color: var(--teal); }
        .card-patient  .badge-role { background: rgba(34,197,94,0.15);  color: var(--green); }

        /* ─── Footer ──────────────────────────────────────────── */
        .portal-footer {
            margin-top: 3rem; color: var(--muted); font-size: 0.78rem; text-align: center;
        }
    </style>
</head>
<body>
    <div class="orbs">
        <div class="orb orb1"></div>
        <div class="orb orb2"></div>
        <div class="orb orb3"></div>
    </div>

    <div class="portal-wrap">
        <!-- Logo -->
        <div class="portal-logo">
            <i class="bi bi-tooth-fill"></i>
            DentaCare
        </div>
        <p class="portal-subtitle">Select your portal to continue</p>

        <!-- Role cards -->
        <div class="portal-grid">

            <!-- Secretary -->
            <a asp-controller="Account" asp-action="SecretaryLogin" class="portal-card card-secretary" id="portal-secretary">
                <div class="icon-wrap"><i class="bi bi-shield-lock-fill"></i></div>
                <div class="badge-role">Admin</div>
                <h2>Secretary</h2>
                <p>Manage all appointments, record payments, oversee the full clinic calendar and patient records.</p>
                <span class="portal-btn"><i class="bi bi-box-arrow-in-right"></i>Secretary Login</span>
            </a>

            <!-- Doctor -->
            <a asp-controller="Account" asp-action="DoctorLogin" class="portal-card card-doctor" id="portal-doctor">
                <div class="icon-wrap"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                <div class="badge-role">Medical Staff</div>
                <h2>Doctor</h2>
                <p>Access your personal schedule, view patient notes and complaints, and track daily earnings.</p>
                <span class="portal-btn"><i class="bi bi-box-arrow-in-right"></i>Doctor Login</span>
            </a>

            <!-- Patient -->
            <a asp-controller="Account" asp-action="Login" class="portal-card card-patient" id="portal-patient">
                <div class="icon-wrap"><i class="bi bi-person-heart"></i></div>
                <div class="badge-role">Patient</div>
                <h2>Patient</h2>
                <p>Book appointments online, view upcoming visits, receive reminders, and check your payment history.</p>
                <span class="portal-btn"><i class="bi bi-box-arrow-in-right"></i>Patient Login</span>
            </a>

        </div>

        <div class="portal-footer">
            &copy; @DateTime.Now.Year DentaCare Clinic &nbsp;·&nbsp;
            New patient? <a asp-controller="Account" asp-action="Register" style="color:var(--green);">Register here</a>
        </div>
    </div>
</body>
</html>
