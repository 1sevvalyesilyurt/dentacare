@model DentalClinic.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Secretary Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — DentaCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css"/>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { min-height:100vh; font-family:'Inter',sans-serif; color:#f0e8e8;
               display:flex; align-items:center; justify-content:center;
               background:#0f0d0d; position:relative; overflow:hidden; }
        .glow { position:fixed; width:600px; height:600px; border-radius:50%;
                background:radial-gradient(circle, rgba(220,38,38,0.18) 0%, transparent 70%);
                top:-200px; left:-200px; pointer-events:none; }
        .login-wrap { position:relative; z-index:1; width:100%; max-width:420px; padding:1rem; }
        .login-card { background:#1a1212; border:1px solid #2e1f1f; border-radius:20px; padding:2.5rem;
                      box-shadow:0 20px 60px rgba(220,38,38,0.18); }
        .role-badge { display:inline-flex; align-items:center; gap:0.4rem;
                      background:rgba(220,38,38,0.15); color:#ef4444;
                      padding:4px 12px; border-radius:20px; font-size:0.72rem;
                      font-weight:600; letter-spacing:0.08em; text-transform:uppercase; }
        .icon-circle { width:64px; height:64px; border-radius:50%; background:rgba(220,38,38,0.12);
                       display:flex; align-items:center; justify-content:center;
                       font-size:1.75rem; color:#ef4444; margin:0 auto 1rem; }
        h1 { font-size:1.5rem; font-weight:800; text-align:center; margin-bottom:0.25rem; }
        .subtitle { color:#9e8080; font-size:0.83rem; text-align:center; margin-bottom:1.75rem; }
        .form-label { font-size:0.8rem; color:#9e8080; font-weight:500; margin-bottom:4px; }
        .form-control { background:#120d0d !important; border:1px solid #2e1f1f !important;
                        color:#f0e8e8 !important; border-radius:10px; }
        .form-control:focus { border-color:#dc2626 !important; box-shadow:0 0 0 3px rgba(220,38,38,0.2) !important; }
        .btn-login { background:linear-gradient(135deg,#dc2626 0%,#b91c1c 100%); color:#fff;
                     border:none; border-radius:10px; padding:0.7rem; font-weight:700;
                     font-size:0.95rem; width:100%; transition:transform 0.15s,box-shadow 0.15s; }
        .btn-login:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(220,38,38,0.45); }
        .back-link { display:flex; align-items:center; gap:0.4rem; color:#9e8080;
                     font-size:0.82rem; text-decoration:none; margin-bottom:1.5rem; }
        .back-link:hover { color:#ef4444; }
        .alert-danger { background:rgba(220,38,38,0.12); border-color:rgba(220,38,38,0.3);
                        color:#ef4444; border-radius:10px; font-size:0.85rem; }
    </style>
</head>
<body>
    <div class="glow"></div>
    <div class="login-wrap">
        <a asp-controller="Home" asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to portal
        </a>
        <div class="login-card">
            <div class="text-center mb-3">
                <div class="icon-circle"><i class="bi bi-shield-lock-fill"></i></div>
                <div class="role-badge mb-2"><i class="bi bi-circle-fill" style="font-size:6px;"></i>Admin Portal</div>
                <h1>Secretary Login</h1>
                <p class="subtitle">Clinic administration &amp; management</p>
            </div>
            <form asp-action="SecretaryLogin" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="admin@dentacare.com" id="sec-email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" id="sec-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn-login" id="btn-sec-login">
                    <i class="bi bi-shield-check me-2"></i>Sign In as Secretary
                </button>
            </form>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
