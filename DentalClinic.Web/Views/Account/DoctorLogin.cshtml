@model DentalClinic.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Doctor Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — DentaCare</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { min-height:100vh; font-family:'Inter',sans-serif; color:#e8f4f4;
               display:flex; align-items:center; justify-content:center;
               background:#091b1d; position:relative; overflow:hidden; }
        .glow  { position:fixed; width:700px; height:700px; border-radius:50%; pointer-events:none;
                 background:radial-gradient(circle, rgba(15,164,175,0.2) 0%, transparent 70%);
                 top:-200px; right:-200px; }
        .glow2 { position:fixed; width:350px; height:350px; border-radius:50%; pointer-events:none;
                 background:radial-gradient(circle, rgba(15,164,175,0.1) 0%, transparent 70%);
                 bottom:-100px; left:-50px; }
        .login-wrap { position:relative; z-index:1; width:100%; max-width:420px; padding:1rem; }
        .login-card { background:#0f2527; border:1px solid #1a3d40; border-radius:20px; padding:2.5rem;
                      box-shadow:0 20px 60px rgba(15,164,175,0.2); }
        .role-badge { display:inline-flex; align-items:center; gap:0.4rem;
                      background:rgba(15,164,175,0.15); color:#0fa4af;
                      padding:4px 12px; border-radius:20px; font-size:0.72rem;
                      font-weight:600; letter-spacing:0.08em; text-transform:uppercase; }
        .icon-circle { width:64px; height:64px; border-radius:50%; background:rgba(15,164,175,0.15);
                       display:flex; align-items:center; justify-content:center;
                       font-size:1.75rem; color:#0fa4af; margin:0 auto 1rem; }
        h1 { font-size:1.5rem; font-weight:800; text-align:center; margin-bottom:0.25rem; }
        .subtitle { color:#5a8a8d; font-size:0.83rem; text-align:center; margin-bottom:1.75rem; }
        .form-label { font-size:0.8rem; color:#5a8a8d; font-weight:500; margin-bottom:4px; }
        .form-control { background:#071618 !important; border:1px solid #1a3d40 !important;
                        color:#e8f4f4 !important; border-radius:10px; }
        .form-control:focus { border-color:#0fa4af !important; box-shadow:0 0 0 3px rgba(15,164,175,0.25) !important; }
        .btn-login { background:linear-gradient(135deg,#0fa4af 0%,#0d8a94 100%); color:#fff;
                     border:none; border-radius:10px; padding:0.7rem; font-weight:700;
                     font-size:0.95rem; width:100%; transition:transform 0.15s,box-shadow 0.15s; }
        .btn-login:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(15,164,175,0.5); }
        .back-link { display:flex; align-items:center; gap:0.4rem; color:#5a8a8d;
                     font-size:0.82rem; text-decoration:none; margin-bottom:1.5rem; }
        .back-link:hover { color:#0fa4af; }
        .alert-danger { background:rgba(239,68,68,0.1); border-color:rgba(239,68,68,0.3);
                        color:#f87171; border-radius:10px; font-size:0.85rem; }
    </style>
</head>
<body>
    <div class="glow"></div><div class="glow2"></div>
    <div class="login-wrap">
        <a asp-controller="Home" asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to portal
        </a>
        <div class="login-card">
            <div class="text-center mb-3">
                <div class="icon-circle"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                <div class="role-badge mb-2"><i class="bi bi-circle-fill" style="font-size:6px;"></i>Medical Staff</div>
                <h1>Doctor Login</h1>
                <p class="subtitle">Access your personal schedule &amp; dashboard</p>
            </div>
            <form asp-action="DoctorLogin" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="dr.name@dentacare.com" id="doc-email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" id="doc-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn-login" id="btn-doc-login">
                    <i class="bi bi-clipboard2-heart me-2"></i>Sign In as Doctor
                </button>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
