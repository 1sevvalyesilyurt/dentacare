@model List<DentalClinic.Web.Models.Doctor>
@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="container-fluid px-4">
    <div class="dc-page-header d-flex align-items-center justify-content-between">
        <div>
            <h1><i class="bi bi-person-badge text-teal me-2"></i>Doctors</h1>
            <p class="text-muted small mb-0">@Model.Count(d => d.IsActive) active · @Model.Count(d => !d.IsActive) inactive</p>
        </div>
        <a asp-action="CreateDoctor" class="btn btn-dc-primary">
            <i class="bi bi-person-plus me-1"></i>Add New Doctor
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="dc-card p-5 text-center">
            <i class="bi bi-person-badge" style="font-size:3rem;color:var(--dc-muted);"></i>
            <h5 class="mt-3 fw-600">No doctors registered yet</h5>
            <p class="text-muted">Add the first doctor to start scheduling appointments.</p>
            <a asp-action="CreateDoctor" class="btn btn-dc-primary mt-2">Add Doctor</a>
        </div>
    }
    else
    {
        <div class="dc-card">
            <div class="p-0">
                <table class="dc-table">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Specialty</th>
                            <th>Working Hours</th>
                            <th>Slot</th>
                            <th>Commission</th>
                            <th>Appointments</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="dc-avatar" style="background:var(--dc-teal);width:36px;height:36px;font-size:0.85rem;">
                                            @doc.User?.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-600">Dr. @doc.User?.FullName</div>
                                            <div class="text-muted small">@doc.User?.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@doc.Specialty</td>
                                <td class="text-muted small">
                                    @doc.WorkingHoursStart.ToString(@"hh\:mm") –
                                    @doc.WorkingHoursEnd.ToString(@"hh\:mm")
                                </td>
                                <td class="text-muted small">@doc.SlotDurationMinutes min</td>
                                <td class="fw-600 text-teal">@((doc.CommissionRate * 100).ToString("0"))%</td>
                                <td>
                                    <span class="fw-600">@doc.Appointments.Count</span>
                                    <span class="text-muted small ms-1">total</span>
                                </td>
                                <td>
                                    @if (doc.IsActive)
                                    {
                                        <span class="badge-completed">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-cancelled">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="ToggleDoctor" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@doc.DoctorId" />
                                        <button type="submit"
                                                class="btn btn-sm @(doc.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                onclick="return confirm('@(doc.IsActive ? "Deactivate" : "Activate") Dr. @doc.User?.FullName?')">
                                            @if (doc.IsActive)
                                            {
                                                <i class="bi bi-toggle-on me-1"></i><text>Deactivate</text>
                                            }
                                            else
                                            {
                                                <i class="bi bi-toggle-off me-1"></i><text>Activate</text>
                                            }
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
