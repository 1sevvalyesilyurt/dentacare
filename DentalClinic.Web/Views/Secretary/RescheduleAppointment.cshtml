@model DentalClinic.Web.ViewModels.RescheduleAppointmentViewModel
@{
    ViewData["Title"] = "Reschedule Appointment";
}

<div class="container" style="max-width:780px;">
    <div class="dc-page-header">
        <h1><i class="bi bi-arrow-repeat text-teal me-2"></i>Reschedule Appointment</h1>
        <p class="text-muted small mb-0">Select a new date and an available slot for this appointment.</p>
    </div>

    <div class="dc-card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-muted small">Patient</div>
                <div class="fw-600">@Model.PatientName</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Doctor</div>
                <div class="fw-600">Dr. @Model.DoctorName</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Service</div>
                <div class="fw-600">@Model.ServiceName</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Current Date & Time</div>
                <div class="fw-600 text-teal">@Model.CurrentAppointmentDate.ToString("dddd, dd MMM yyyy HH:mm")</div>
            </div>
        </div>
    </div>

    <div class="dc-card p-4">
        <form asp-action="RescheduleAppointment" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

            <input asp-for="AppointmentId" type="hidden" />
            <input asp-for="DoctorId" type="hidden" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NewDate" class="form-label"></label>
                    <input asp-for="NewDate" type="date" class="form-control" id="new-date" />
                    <span asp-validation-for="NewDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NewTime" class="form-label"></label>
                    <select asp-for="NewTime" class="form-select" id="new-time">
                        @foreach (var slot in Model.AvailableSlots)
                        {
                            <option value="@slot">@slot</option>
                        }
                    </select>
                    <span asp-validation-for="NewTime" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-dc-primary">
                    <i class="bi bi-check2-circle me-1"></i>Save New Slot
                </button>
                <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const dateInput = document.getElementById('new-date');
        const timeSelect = document.getElementById('new-time');
        const doctorId = @Model.DoctorId;
        const appointmentId = @Model.AppointmentId;
        const slotsUrlBase = '@Url.Action("AvailableSlots", "Secretary")';

        async function refreshSlots() {
            const selectedDate = dateInput.value;
            if (!selectedDate) return;

            const url = `${slotsUrlBase}?doctorId=${doctorId}&date=${selectedDate}&appointmentId=${appointmentId}`;
            const res = await fetch(url);
            if (!res.ok) return;

            const slots = await res.json();
            const currentSelection = timeSelect.value;
            timeSelect.innerHTML = '';

            if (!slots || slots.length === 0) {
                const emptyOption = document.createElement('option');
                emptyOption.value = '';
                emptyOption.textContent = 'No available slots';
                timeSelect.appendChild(emptyOption);
                return;
            }

            slots.forEach(slot => {
                const option = document.createElement('option');
                option.value = slot;
                option.textContent = slot;
                if (slot === currentSelection) option.selected = true;
                timeSelect.appendChild(option);
            });
        }

        dateInput.addEventListener('change', refreshSlots);
    </script>
}
