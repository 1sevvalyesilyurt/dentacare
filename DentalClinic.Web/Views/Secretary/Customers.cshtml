@model List<DentalClinic.Web.Models.Customer>
@using DentalClinic.Web.Models
@{
    ViewData["Title"] = "Customers";
}

<div class="container-fluid px-4">
    <div class="dc-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1><i class="bi bi-people text-teal me-2"></i>Customers</h1>
            <p class="text-muted small mb-0">@Model.Count registered patient(s)</p>
        </div>
    </div>

    <div class="dc-card">
        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <i class="bi bi-people" style="font-size:2.5rem;color:var(--dc-muted);"></i>
                <h5 class="mt-3 fw-600">No customers yet</h5>
                <p class="text-muted">Patients will appear here after they register.</p>
            </div>
        }
        else
        {
            <div class="p-0">
                <table class="dc-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Appointments</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="fw-600">@c.User?.FullName</td>
                                <td class="text-muted small">@c.User?.Email</td>
                                <td class="text-muted small">@(c.User?.PhoneNumber ?? "—")</td>
                                <td>
                                    <span class="badge bg-secondary">@c.Appointments.Count total</span>
                                </td>
                                <td>
                                    @if (c.User?.IsActive == true)
                                    {
                                        <span class="badge-confirmed">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-cancelled">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
