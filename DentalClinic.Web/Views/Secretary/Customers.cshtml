@model List<DentalClinic.Web.Models.Customer>
@{
    ViewData["Title"] = "Patients";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="dc-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1><i class="bi bi-people text-teal me-2"></i>Patients</h1>
            <p class="text-muted small mb-0">@Model.Count registered patient(s)</p>
        </div>
        <!-- Search -->
        <div class="dc-card p-2 d-flex align-items-center gap-2" style="min-width:260px;">
            <i class="bi bi-search text-muted ms-1"></i>
            <input type="text" id="patient-search" class="form-control border-0 shadow-none p-0"
                   placeholder="Search by name or phone…" style="background:transparent;" />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="dc-card p-5 text-center">
            <i class="bi bi-people" style="font-size:3rem;color:var(--dc-muted);"></i>
            <h5 class="mt-3 fw-600">No patients registered yet</h5>
            <p class="text-muted">Patients register themselves via the public registration page.</p>
        </div>
    }
    else
    {
        <div class="dc-card">
            <div class="p-0">
                <table class="dc-table" id="patients-table">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Phone</th>
                            <th>Date of Birth</th>
                            <th>Medical Notes</th>
                            <th>Total Appointments</th>
                            <th>Registered</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr class="patient-row"
                                data-name="@(customer.User?.FullName?.ToLower())"
                                data-phone="@(customer.User?.PhoneNumber?.ToLower())">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="dc-avatar" style="background:var(--dc-accent);width:36px;height:36px;font-size:0.85rem;">
                                            @customer.User?.FullName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-600">@customer.User?.FullName</div>
                                            <div class="text-muted small">@customer.User?.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">@(customer.User?.PhoneNumber ?? "—")</td>
                                <td class="text-muted small">
                                    @(customer.User?.DateOfBirth.HasValue == true
                                        ? customer.User.DateOfBirth.Value.ToString("dd MMM yyyy")
                                        : "—")
                                </td>
                                <td class="text-muted small">
                                    @if (!string.IsNullOrEmpty(customer.MedicalNotes))
                                    {
                                        <span title="@customer.MedicalNotes">
                                            @(customer.MedicalNotes.Length > 30 ? customer.MedicalNotes[..30] + "…" : customer.MedicalNotes)
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-600">@customer.Appointments.Count</span>
                                    <span class="text-muted small ms-1">total</span>
                                </td>
                                <td class="text-muted small">
                                    @(customer.User?.CreatedAt.ToString("dd MMM yyyy") ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    document.getElementById('patient-search')?.addEventListener('input', function () {
        const q = this.value.toLowerCase().trim();
        document.querySelectorAll('.patient-row').forEach(row => {
            const name  = row.dataset.name  || '';
            const phone = row.dataset.phone || '';
            row.style.display = (!q || name.includes(q) || phone.includes(q)) ? '' : 'none';
        });
    });
</script>
}
