@model List<DentalClinic.Web.Models.Service>
@{
    ViewData["Title"] = "Services";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="dc-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1><i class="bi bi-clipboard2-pulse text-teal me-2"></i>Services</h1>
            <p class="text-muted small mb-0">@Model.Count(s => s.IsActive) active · @Model.Count(s => !s.IsActive) inactive</p>
        </div>
        <button class="btn btn-dc-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
            <i class="bi bi-plus-circle me-1"></i>Add Service
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="dc-card p-5 text-center">
            <i class="bi bi-clipboard2-pulse" style="font-size:3rem;color:var(--dc-muted);"></i>
            <h5 class="mt-3 fw-600">No services defined yet</h5>
            <p class="text-muted">Add the first service to start booking appointments.</p>
            <button class="btn btn-dc-primary mt-2" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                Add Service
            </button>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var service in Model.OrderByDescending(s => s.IsActive).ThenBy(s => s.Name))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="dc-card p-4 h-100" style="@(service.IsActive ? "" : "opacity:0.55;")">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="dc-stat-icon teal" style="width:44px;height:44px;border-radius:12px;">
                                <i class="bi bi-clipboard2-heart"></i>
                            </div>
                            @if (service.IsActive)
                            {
                                <span class="badge-completed">Active</span>
                            }
                            else
                            {
                                <span class="badge-cancelled">Inactive</span>
                            }
                        </div>
                        <div class="fw-700 mb-1">@service.Name</div>
                        @if (!string.IsNullOrEmpty(service.Description))
                        {
                            <div class="text-muted small mb-3">@service.Description</div>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3"
                             style="border-top:1px solid var(--dc-border);">
                            <div>
                                <span class="text-teal fw-700 fs-5">₺@service.BaseFee.ToString("N0")</span>
                                <span class="text-muted small ms-2">@service.DurationMinutes min</span>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-secondary"
                                        onclick="openEditModal(@service.ServiceId, '@Html.Raw(service.Name.Replace("'","\\\'"))', '@Html.Raw((service.Description ?? "").Replace("'","\\\'"))', @service.BaseFee, @service.DurationMinutes, @(service.IsActive ? "true" : "false"))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--dc-navy-mid);border:1px solid var(--dc-border);border-radius:16px;">
            <div class="modal-header" style="border-color:var(--dc-border);">
                <h5 class="modal-title fw-600"><i class="bi bi-plus-circle text-teal me-2"></i>Add New Service</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddService" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Service Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Root Canal Treatment" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-muted small">(optional)</span></label>
                        <textarea name="Description" class="form-control" rows="2"
                                  placeholder="Short description of the service…"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Base Fee (₺)</label>
                            <input type="number" name="BaseFee" class="form-control" min="0" step="50" value="500" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Duration (minutes)</label>
                            <select name="DurationMinutes" class="form-select">
                                <option value="15">15 min</option>
                                <option value="20">20 min</option>
                                <option value="30" selected>30 min</option>
                                <option value="45">45 min</option>
                                <option value="60">60 min</option>
                                <option value="90">90 min</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-color:var(--dc-border);">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dc-primary">
                        <i class="bi bi-check2 me-1"></i>Add Service
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--dc-navy-mid);border:1px solid var(--dc-border);border-radius:16px;">
            <div class="modal-header" style="border-color:var(--dc-border);">
                <h5 class="modal-title fw-600"><i class="bi bi-pencil text-teal me-2"></i>Edit Service</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditService" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ServiceId" id="edit-service-id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Service Name</label>
                        <input type="text" name="Name" id="edit-name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" id="edit-description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Base Fee (₺)</label>
                            <input type="number" name="BaseFee" id="edit-fee" class="form-control" min="0" step="50" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Duration (minutes)</label>
                            <select name="DurationMinutes" id="edit-duration" class="form-select">
                                <option value="15">15 min</option>
                                <option value="20">20 min</option>
                                <option value="30">30 min</option>
                                <option value="45">45 min</option>
                                <option value="60">60 min</option>
                                <option value="90">90 min</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check mt-3">
                        <input type="checkbox" name="IsActive" id="edit-active" class="form-check-input" value="true" />
                        <label class="form-check-label" for="edit-active">Active</label>
                    </div>
                </div>
                <div class="modal-footer" style="border-color:var(--dc-border);">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dc-primary">
                        <i class="bi bi-check2 me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditModal(id, name, description, fee, duration, isActive) {
        document.getElementById('edit-service-id').value  = id;
        document.getElementById('edit-name').value        = name;
        document.getElementById('edit-description').value = description;
        document.getElementById('edit-fee').value         = fee;
        document.getElementById('edit-duration').value    = duration;
        document.getElementById('edit-active').checked    = isActive;
        new bootstrap.Modal(document.getElementById('editServiceModal')).show();
    }
</script>
}
