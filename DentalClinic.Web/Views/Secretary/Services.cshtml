@model List<DentalClinic.Web.Models.Service>
@{
    ViewData["Title"] = "Service Management";
}

<div class="container-fluid px-4">
    <div class="dc-page-header">
        <h1><i class="bi bi-clipboard2-pulse text-teal me-2"></i>Services</h1>
        <p class="text-muted small mb-0">@Model.Count service(s) · @Model.Count(s => s.IsActive) active</p>
    </div>

    <div class="dc-card p-4 mb-4">
        <h5 class="fw-600 mb-3">Add New Service</h5>
        <form asp-action="CreateService" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input name="Name" class="form-control" required maxlength="150" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Base Fee (₺)</label>
                    <input name="BaseFee" type="number" min="0" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Duration (minutes)</label>
                    <input name="DurationMinutes" type="number" min="5" max="480" class="form-control" required />
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-dc-primary">
                        <i class="bi bi-plus-circle me-1"></i>Create Service
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="dc-card">
        <div class="dc-card-header d-flex align-items-center">
            <i class="bi bi-list-ul text-teal me-2"></i>
            <h5 class="mb-0 fw-600">Manage Existing Services</h5>
        </div>

        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">No services found.</div>
        }
        else
        {
            <div class="p-0">
                <table class="dc-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Fee</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Edit</th>
                            <th>Toggle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in Model)
                        {
                            <tr>
                                <td class="fw-600">@service.Name</td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(service.Description) ? "-" : service.Description)</td>
                                <td class="fw-600">₺@service.BaseFee.ToString("N2")</td>
                                <td>@service.DurationMinutes min</td>
                                <td>
                                    @if (service.IsActive)
                                    {
                                        <span class="badge-completed">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-cancelled">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="EditService" asp-route-id="@service.ServiceId" method="post" class="d-flex flex-column gap-2">
                                        @Html.AntiForgeryToken()
                                        <input name="Name" class="form-control form-control-sm" value="@service.Name" required maxlength="150" />
                                        <input name="BaseFee" type="number" min="0" step="0.01" class="form-control form-control-sm" value="@service.BaseFee.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required />
                                        <input name="DurationMinutes" type="number" min="5" max="480" class="form-control form-control-sm" value="@service.DurationMinutes" required />
                                        <textarea name="Description" class="form-control form-control-sm" rows="2" maxlength="500">@service.Description</textarea>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil-square me-1"></i>Save
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="ToggleService" asp-route-id="@service.ServiceId" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm @(service.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                onclick="return confirm('Change status for @service.Name?')">
                                            @if (service.IsActive)
                                            {
                                                <i class="bi bi-toggle-on me-1"></i><text>Deactivate</text>
                                            }
                                            else
                                            {
                                                <i class="bi bi-toggle-off me-1"></i><text>Activate</text>
                                            }
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
