@model DentalClinic.Web.ViewModels.PaymentRecordViewModel
@using DentalClinic.Web.Models
@{
    ViewData["Title"] = "Record Payment";
}

<div class="container" style="max-width:620px;">
    <div class="dc-page-header">
        <h1><i class="bi bi-cash-stack text-teal me-2"></i>Record Payment</h1>
        <p class="text-muted small mb-0">Issue payment for a completed appointment.</p>
    </div>

    <!-- Appointment Info Card -->
    <div class="dc-card p-4 mb-4" style="background:var(--dc-navy);">
        <div class="text-muted small fw-600 mb-3 text-uppercase" style="letter-spacing:.05em;">Appointment Details</div>
        <div class="row g-2 small">
            <div class="col-6">
                <span class="text-muted">Patient</span>
                <div class="fw-600">@Model.PatientName</div>
            </div>
            <div class="col-6">
                <span class="text-muted">Doctor</span>
                <div class="fw-600">Dr. @Model.DoctorName</div>
            </div>
            <div class="col-6">
                <span class="text-muted">Service</span>
                <div class="fw-600">@Model.ServiceName</div>
            </div>
            <div class="col-6">
                <span class="text-muted">Date & Time</span>
                <div class="fw-600">@Model.AppointmentDate.ToString("dd MMM yyyy HH:mm")</div>
            </div>
            <div class="col-12 pt-2 border-top" style="border-color:var(--dc-border) !important;">
                <span class="text-muted">Suggested Fee</span>
                <div class="fw-700 text-teal fs-5">₺@Model.SuggestedFee.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- Payment Form -->
    <div class="dc-card p-4">
        <form asp-action="RecordPayment" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AppointmentId" />
            <input type="hidden" asp-for="PatientName" />
            <input type="hidden" asp-for="DoctorName" />
            <input type="hidden" asp-for="ServiceName" />
            <input type="hidden" asp-for="AppointmentDate" />
            <input type="hidden" asp-for="SuggestedFee" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Amount" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text" style="background:var(--dc-navy-mid);border-color:var(--dc-border);color:var(--dc-muted);">₺</span>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control" id="payment-amount" />
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
                <div class="form-text text-muted small">
                    <button type="button" class="btn btn-sm p-0 text-teal" style="background:none;border:none;"
                            onclick="document.getElementById('payment-amount').value = '@Model.SuggestedFee'">
                        <i class="bi bi-arrow-left-right me-1"></i>Use suggested fee (₺@Model.SuggestedFee.ToString("N0"))
                    </button>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <div class="d-flex gap-3 flex-wrap">
                    @foreach (PaymentMethod method in Enum.GetValues(typeof(PaymentMethod)))
                    {
                        <div class="form-check dc-radio-card">
                            <input class="form-check-input" type="radio" asp-for="PaymentMethod"
                                   value="@method" id="method-@method" />
                            <label class="form-check-label" for="method-@method">
                                @switch (method)
                                {
                                    case PaymentMethod.Cash:
                                        <i class="bi bi-cash me-1"></i>
                                        break;
                                    case PaymentMethod.CreditCard:
                                        <i class="bi bi-credit-card me-1"></i>
                                        break;
                                    case PaymentMethod.BankTransfer:
                                        <i class="bi bi-bank me-1"></i>
                                        break;
                                }
                                @method
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-dc-primary px-4" id="btn-record-payment">
                    <i class="bi bi-check2-circle me-1"></i>Record Payment & Generate Invoice
                </button>
                <a asp-action="Payments" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
