@model List<DentalClinic.Web.Models.Appointment>
@using DentalClinic.Web.Models
@{
    ViewData["Title"] = "Appointment Calendar";
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
}

<div class="container-fluid px-4">
    <div class="dc-page-header d-flex align-items-center justify-content-between">
        <div>
            <h1><i class="bi bi-calendar3 text-teal me-2"></i>Calendar</h1>
            <p class="text-muted small mb-0">@selectedDate.ToString("dddd, dd MMMM yyyy")</p>
        </div>
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="date" name="date" class="form-control" value="@selectedDate.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-dc-primary">Go</button>
        </form>
    </div>

    <div class="dc-card">
        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--dc-muted);"></i>
                <h5 class="mt-3 fw-600">No appointments on this date</h5>
                <p class="text-muted mb-3">Create a new appointment from the secretary panel.</p>
                <a asp-action="CreateAppointment" class="btn btn-dc-primary">
                    <i class="bi bi-plus-circle me-1"></i>Create Appointment
                </a>
            </div>
        }
        else
        {
            <div class="p-0">
                <table class="dc-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Service</th>
                            <th>Fee</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td class="fw-600">@appt.AppointmentDate.ToString("HH:mm")</td>
                                <td>@appt.Customer?.User?.FullName</td>
                                <td>Dr. @appt.Doctor?.User?.FullName</td>
                                <td class="text-muted small">@appt.Service?.Name</td>
                                <td class="fw-600">₺@appt.Fee.ToString("N2")</td>
                                <td>
                                    @switch (appt.Status)
                                    {
                                        case AppointmentStatus.Confirmed:
                                            <span class="badge-confirmed">Confirmed</span>
                                            break;
                                        case AppointmentStatus.Completed:
                                            <span class="badge-completed">Completed</span>
                                            break;
                                        case AppointmentStatus.Cancelled:
                                            <span class="badge-cancelled">Cancelled</span>
                                            break;
                                        case AppointmentStatus.Pending:
                                            <span class="badge-pending">Pending</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (appt.Status == AppointmentStatus.Pending || appt.Status == AppointmentStatus.Confirmed)
                                    {
                                        <a asp-action="RescheduleAppointment" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-outline-secondary me-1">
                                            <i class="bi bi-arrow-repeat me-1"></i>Reschedule
                                        </a>
                                        <form asp-action="CancelAppointment" asp-route-id="@appt.AppointmentId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Cancel this appointment?')">
                                                <i class="bi bi-x-circle me-1"></i>Cancel
                                            </button>
                                        </form>
                                    }
                                    else if (appt.Status == AppointmentStatus.Completed && appt.Payment == null)
                                    {
                                        <a asp-action="RecordPayment" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-sm btn-dc-primary">
                                            <i class="bi bi-credit-card me-1"></i>Record Payment
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
