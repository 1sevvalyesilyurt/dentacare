@model List<DentalClinic.Web.Models.Appointment>
@using DentalClinic.Web.Models
@{
    ViewData["Title"] = "Appointment Calendar";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
    var grouped = Model.GroupBy(a => a.DoctorId).ToList();
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="dc-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1><i class="bi bi-calendar3 text-teal me-2"></i>Appointment Calendar</h1>
            <p class="text-muted small mb-0">@selectedDate.ToString("dddd, dd MMMM yyyy") — @Model.Count appointment(s)</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="Calendar" asp-route-date="@selectedDate.AddDays(-1).ToString("yyyy-MM-dd")"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-chevron-left"></i>
            </a>
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="date" name="date" class="form-control form-control-sm" style="width:170px;"
                       value="@selectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </form>
            <a asp-action="Calendar" asp-route-date="@selectedDate.AddDays(1).ToString("yyyy-MM-dd")"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-action="Calendar" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")"
               class="btn btn-dc-primary btn-sm">
                <i class="bi bi-calendar-event me-1"></i>Today
            </a>
            <a asp-action="CreateAppointment" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-plus-circle me-1"></i>New Appointment
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="dc-card p-5 text-center">
            <i class="bi bi-calendar-x" style="font-size:3rem;color:var(--dc-muted);"></i>
            <h5 class="mt-3 fw-600">No appointments for this day</h5>
            <p class="text-muted">Try a different date or create a new appointment.</p>
            <a asp-action="CreateAppointment" class="btn btn-dc-primary mt-2">
                <i class="bi bi-plus-circle me-1"></i>Create Appointment
            </a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var doctorGroup in grouped)
            {
                var firstAppt = doctorGroup.First();
                var doctorName = firstAppt.Doctor?.User?.FullName ?? "Unknown Doctor";
                var specialty  = firstAppt.Doctor?.Specialty ?? "";

                <div class="col-12">
                    <div class="dc-card">
                        <!-- Doctor header -->
                        <div class="dc-card-header d-flex align-items-center gap-3">
                            <div class="dc-avatar" style="background:var(--dc-teal);width:40px;height:40px;font-size:1rem;">
                                @doctorName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <div class="fw-600">Dr. @doctorName</div>
                                <div class="text-muted small">@specialty</div>
                            </div>
                            <span class="badge bg-secondary ms-auto">@doctorGroup.Count() patient(s)</span>
                        </div>
                        <div class="p-0">
                            <table class="dc-table">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        <th>Patient</th>
                                        <th>Service</th>
                                        <th>Note</th>
                                        <th>Fee</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appt in doctorGroup.OrderBy(a => a.AppointmentDate))
                                    {
                                        <tr>
                                            <td class="fw-600 text-teal">@appt.AppointmentDate.ToString("HH:mm")</td>
                                            <td>
                                                <div class="fw-600">@appt.Customer?.User?.FullName</div>
                                                <div class="text-muted small">@appt.Customer?.User?.PhoneNumber</div>
                                            </td>
                                            <td class="text-muted small">@appt.Service?.Name</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(appt.PatientNote))
                                                {
                                                    <span class="small fst-italic text-muted" title="@appt.PatientNote">
                                                        @(appt.PatientNote.Length > 40 ? appt.PatientNote[..40] + "…" : appt.PatientNote)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td class="fw-600">₺@appt.Fee.ToString("N0")</td>
                                            <td>
                                                @switch (appt.Status)
                                                {
                                                    case AppointmentStatus.Confirmed:
                                                        <span class="badge-confirmed">Confirmed</span>
                                                        break;
                                                    case AppointmentStatus.Completed:
                                                        <span class="badge-completed">Completed</span>
                                                        break;
                                                    case AppointmentStatus.Cancelled:
                                                        <span class="badge-cancelled">Cancelled</span>
                                                        break;
                                                    case AppointmentStatus.Pending:
                                                        <span class="badge-pending">Pending</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @if (appt.Status == AppointmentStatus.Confirmed || appt.Status == AppointmentStatus.Pending)
                                                {
                                                    <form asp-action="CancelAppointment" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appt.AppointmentId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Cancel appointment for @appt.Customer?.User?.FullName?')">
                                                            <i class="bi bi-x-circle me-1"></i>Cancel
                                                        </button>
                                                    </form>
                                                }
                                                else if (appt.Status == AppointmentStatus.Completed && appt.Payment == null)
                                                {
                                                    <a asp-action="RecordPayment" asp-route-appointmentId="@appt.AppointmentId"
                                                       class="btn btn-sm btn-dc-primary">
                                                        <i class="bi bi-cash me-1"></i>Pay
                                                    </a>
                                                }
                                                else if (appt.Status == AppointmentStatus.Completed && appt.Payment != null)
                                                {
                                                    <span class="text-muted small"><i class="bi bi-check-circle-fill text-success me-1"></i>Paid</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
