@model List<DentalClinic.Web.Models.Appointment>
@using DentalClinic.Web.Models
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container">
    <div class="dc-page-header d-flex align-items-center justify-content-between">
        <div>
            <h1><i class="bi bi-calendar-check text-teal me-2"></i>Upcoming Appointments</h1>
            <p class="text-muted small mb-0">Your confirmed upcoming visits</p>
        </div>
        <a asp-action="Book" class="btn btn-dc-primary">
            <i class="bi bi-plus-circle me-1"></i>New Booking
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="dc-card p-5 text-center">
            <i class="bi bi-calendar-x" style="font-size:3rem;color:var(--dc-muted);"></i>
            <h5 class="mt-3 fw-600">No upcoming appointments</h5>
            <p class="text-muted">Book your first appointment now and take care of your smile.</p>
            <a asp-action="Book" class="btn btn-dc-primary mt-2">Book an Appointment</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var appt in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="dc-card p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge-confirmed">@appt.Status</span>
                            </div>
                            <span class="text-muted small">
                                <i class="bi bi-clock me-1"></i>
                                @appt.AppointmentDate.ToString("HH:mm")
                            </span>
                        </div>

                        <div class="mb-1">
                            <span class="text-muted small">DATE</span>
                            <p class="fw-600 mb-0">@appt.AppointmentDate.ToString("dddd, dd MMM yyyy")</p>
                        </div>
                        <hr style="border-color:var(--dc-border);" />
                        <div class="mb-1">
                            <span class="text-muted small">DOCTOR</span>
                            <p class="fw-600 mb-0">Dr. @appt.Doctor?.User?.FullName</p>
                            <span class="text-muted small">@appt.Doctor?.Specialty</span>
                        </div>
                        <div class="mt-2">
                            <span class="text-muted small">SERVICE</span>
                            <p class="fw-600 mb-0">@appt.Service?.Name</p>
                        </div>
                        @if (!string.IsNullOrEmpty(appt.PatientNote))
                        {
                            <div class="mt-2">
                                <span class="text-muted small">YOUR NOTE</span>
                                <p class="small mb-0 fst-italic">"@appt.PatientNote"</p>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2"
                             style="border-top:1px solid var(--dc-border);">
                            <span class="fw-700 text-teal">₺@appt.Fee.ToString("N0")</span>
                            <form asp-action="Cancel" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@appt.AppointmentId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Cancel this appointment?')">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
