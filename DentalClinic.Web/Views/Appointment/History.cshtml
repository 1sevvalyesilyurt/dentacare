@model List<DentalClinic.Web.Models.Appointment>
@using DentalClinic.Web.Models
@{
    ViewData["Title"] = "Visit History";
}

<div class="container">
    <div class="dc-page-header d-flex align-items-center justify-content-between">
        <div>
            <h1><i class="bi bi-clock-history text-teal me-2"></i>Visit History</h1>
            <p class="text-muted small mb-0">Your past appointments and payment records</p>
        </div>
        <a asp-action="Book" class="btn btn-dc-primary">
            <i class="bi bi-plus-circle me-1"></i>New Booking
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="dc-card p-5 text-center">
            <i class="bi bi-clock-history" style="font-size:3rem;color:var(--dc-muted);"></i>
            <h5 class="mt-3 fw-600">No visit history yet</h5>
            <p class="text-muted">Your completed and past appointments will appear here.</p>
            <a asp-action="Book" class="btn btn-dc-primary mt-2">Book an Appointment</a>
        </div>
    }
    else
    {
        <div class="dc-card">
            <div class="p-0">
                <table class="dc-table">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Doctor</th>
                            <th>Service</th>
                            <th>Note</th>
                            <th>Fee</th>
                            <th>Payment</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-600">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted small">@appt.AppointmentDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-600">Dr. @appt.Doctor?.User?.FullName</div>
                                    <div class="text-muted small">@appt.Doctor?.Specialty</div>
                                </td>
                                <td class="text-muted small">@appt.Service?.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(appt.PatientNote))
                                    {
                                        <span class="small fst-italic text-muted" title="@appt.PatientNote">
                                            @(appt.PatientNote.Length > 35 ? appt.PatientNote[..35] + "…" : appt.PatientNote)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="fw-600 text-teal">₺@appt.Fee.ToString("N0")</td>
                                <td>
                                    @if (appt.Payment != null)
                                    {
                                        <div>
                                            <span class="badge-completed"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                            <div class="text-muted small mt-1" style="font-family:monospace;">@appt.Payment.InvoiceNumber</div>
                                            <div class="text-muted small">@appt.Payment.PaymentMethod — @appt.Payment.PaidAt.ToString("dd MMM yyyy")</div>
                                        </div>
                                    }
                                    else if (appt.Status == AppointmentStatus.Completed)
                                    {
                                        <span class="badge-pending">Awaiting Payment</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @switch (appt.Status)
                                    {
                                        case AppointmentStatus.Confirmed:
                                            <span class="badge-confirmed">Confirmed</span>
                                            break;
                                        case AppointmentStatus.Completed:
                                            <span class="badge-completed">Completed</span>
                                            break;
                                        case AppointmentStatus.Cancelled:
                                            <span class="badge-cancelled">Cancelled</span>
                                            break;
                                        case AppointmentStatus.Pending:
                                            <span class="badge-pending">Pending</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
